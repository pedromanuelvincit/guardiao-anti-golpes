# Configuração local do Ollama; nenhuma chave de API é necessária.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
RAG_TOP_K=3
DUCKDB_PATH=data/guardiao.duckdb
# Langfuse é opcional; substitua os placeholders somente no arquivo .env local.
LANGFUSE_SECRET_KEY=sk-lf-sua-chave-secreta
LANGFUSE_PUBLIC_KEY=pk-lf-sua-chave-publica
LANGFUSE_HOST=https://cloud.langfuse.com
